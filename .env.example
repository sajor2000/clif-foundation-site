# Local / Vercel environment variables for CLIF Foundation site
# Copy to .env.local for development. Never commit real secrets.
# The public site runs without variables; online giving needs the campaign code.

# --- Givebutter (public giving on /support) ---
# Account ID defaults in code to the Foundation widget account.
# NEXT_PUBLIC_GIVEBUTTER_ACCOUNT_ID=htqR98I4GhNJ6AiT
# Required to show the embedded giving form (Campaign → Widgets / embed code):
NEXT_PUBLIC_GIVEBUTTER_CAMPAIGN_CODE=

# Optional API key for future server-side Givebutter CRM sync (dashboard → Settings → API):
# GIVEBUTTER_API_KEY=

# --- Stripe (unused; public giving uses Givebutter) ---
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Board portal (/portal): Convex + Clerk ---
# Convex — from `npm run convex:dev` or `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
CONVEX_AGENT_MODE=anonymous

# Clerk JWT issuer (Convex dashboard env + convex/auth.config.ts)
CLERK_JWT_ISSUER_DOMAIN=

# Clerk — board portal sign-in
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

