# Local / Vercel environment variables for CLIF Foundation site
# Copy to .env.local for development. Never commit real secrets.

# --- Convex (local) ---
# From `npx convex dev` (or CONVEX_AGENT_MODE=anonymous npx convex dev).
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
# Local/cloud agents only — do NOT set on Vercel Production/Preview.
CONVEX_AGENT_MODE=anonymous

# Clerk JWT issuer for Convex auth.config.ts (Clerk Frontend API URL)
# Set this on the Convex deployment (dashboard → Environment Variables),
# not only in Vercel. Example: https://your-instance.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# --- Convex (Vercel CI) ---
# Production deploy key → Vercel env: Production only
# Preview deploy key → Vercel env: Preview only
# Generate in Convex dashboard → Deployment Settings → Deploy Keys
# (enable deployment:deploy). Do not commit the key.
CONVEX_DEPLOY_KEY=

# --- Clerk (board portal) — set on Vercel Production + Preview ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/portal/sign-in

# --- Stripe (later — Online giving coming soon until set) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
