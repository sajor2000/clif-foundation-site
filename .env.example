# Local / Vercel environment variables for CLIF Foundation site
# Copy to .env.local for development. Never commit real secrets.

# --- Convex ---
# From `npx convex dev` (local) or the Convex dashboard production deployment.
NEXT_PUBLIC_CONVEX_URL=
# Set by Convex CLI; cloud agents should use CONVEX_AGENT_MODE=anonymous
CONVEX_DEPLOYMENT=
CONVEX_AGENT_MODE=anonymous

# Clerk JWT issuer for Convex auth.config.ts (Clerk Frontend API URL)
# Example: https://your-instance.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# --- Clerk (board portal) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/portal/sign-in

# --- Stripe (later — Online giving coming soon until set) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
