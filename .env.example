# Copy to .env.local for board portal development. Never commit secrets.

# Convex — from `npm run convex:dev` or `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
CONVEX_AGENT_MODE=anonymous

# Clerk JWT issuer (Convex dashboard env + convex/auth.config.ts)
CLERK_JWT_ISSUER_DOMAIN=

# Clerk — board portal sign-in
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional — donations (public site works without)
STRIPE_SECRET_KEY=
